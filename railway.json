{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "node artifacts/api-server/build-ash-v2.mjs"
  },
  "deploy": {
    "startCommand": "node artifacts/api-server/dist/ashV2.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
