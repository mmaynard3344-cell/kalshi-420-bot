  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.1"
