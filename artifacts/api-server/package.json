{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:phase4b": "node scripts/run-phase4b-test.mjs",
    "test:compact-shadow-worker": "node scripts/run-compact-shadow-worker-test.mjs",
    "test:stale-gap-counterfactual": "node scripts/run-stale-gap-counterfactual-test.mjs",
    "test:stale-gap-passive-capture": "node scripts/run-stale-gap-passive-capture-test.mjs",
    "test:stale-gap-counterfactual-export": "node scripts/run-stale-gap-counterfactual-export-test.mjs",
    "test:phase4a": "node scripts/run-phase4a-test.mjs",
    "export:stale-gap-counterfactuals": "node scripts/run-stale-gap-counterfactual-export.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node scripts/apply-dashboard-history-pagination.mjs && node scripts/apply-eth-gtc-cancel-endpoint-fix.mjs && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
