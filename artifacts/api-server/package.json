    "test:analytics-report-loader": "node scripts/run-analytics-report-loader-test.mjs",
    "test:protective-exit": "node scripts/run-protective-exit-test.mjs",
    "test:eth420-live-market": "node scripts/run-eth420-live-market-test.mjs",
    "test:eth420-emergency-reduction": "node scripts/run-eth420-emergency-reduction-test.mjs",
    "test:eth30": "node scripts/run-eth30-test.mjs",
    "test:sol30": "node scripts/run-sol30-test.mjs",
    "test": "node scripts/run-all-tests.mjs"
